# Local/private demo defaults
POSTGRES_DB=nocflow
POSTGRES_USER=nocflow

# REQUIRED for compose.private.yaml. Generate a strong value locally.
POSTGRES_PASSWORD=change-me-locally

# REQUIRED for compose.private.yaml.
# Never commit a real Cloudflare Tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-local-tunnel-token

# Local development keeps the isolated demo identity.
NOCFLOW_ENVIRONMENT=development
NOCFLOW_AUTH_MODE=demo

# Authenticated private demo behind Cloudflare Access:
# NOCFLOW_ENVIRONMENT=staging
# NOCFLOW_AUTH_MODE=cloudflare_access
# NOCFLOW_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# NOCFLOW_CLOUDFLARE_ACCESS_AUDIENCE=replace-with-application-aud-tag
# NOCFLOW_CLOUDFLARE_ACCESS_TENANT_ID=00000000-0000-4000-8000-000000000001
# NOCFLOW_CLOUDFLARE_ACCESS_BOOTSTRAP_ADMIN_EMAIL=you@example.com
#
# The bootstrap email is only for the first private/staging administrator.
# It is ignored in production. After the membership exists, remove this value.

# Generic OIDC remains available for future Entra ID/Auth0/Keycloak deployments.
# NOCFLOW_AUTH_MODE=oidc
# NOCFLOW_OIDC_ISSUER=https://identity.example.com/
# NOCFLOW_OIDC_AUDIENCE=noc-flow-api
# NOCFLOW_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# NOCFLOW_OIDC_ALGORITHMS=["RS256"]
# NOCFLOW_OIDC_TENANT_CLAIM=tenant_id
#
# Roles are NEVER trusted from external claims. They are resolved from the
# internal tenant_memberships table after the external identity is validated.
